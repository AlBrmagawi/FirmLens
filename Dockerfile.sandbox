FROM golang:1.26.8-alpine3.24@sha256:8ac98ca534ac3f51e1f420a1dd2c15e74c75cfa0f23f3ad27eb5d7236c349a0c AS analyzer-build
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOMAXPROCS=2
ADD --checksum=sha256:8b999a1b8bd08b12512176cdec5d063db9cfe209c65cc5de9c4eb2ab7bdc7b3c https://codeload.github.com/anchore/syft/tar.gz/refs/tags/v1.52.0 /tmp/syft.tar.gz
ADD --checksum=sha256:be9c904938d9702e432e3c24ea2288913678af33968405980d2061d6159248b2 https://codeload.github.com/anchore/grype/tar.gz/refs/tags/v0.119.0 /tmp/grype.tar.gz
RUN mkdir -p /src/syft /src/grype /out/provenance \
    && tar -xzf /tmp/syft.tar.gz -C /src/syft --strip-components=1 \
    && tar -xzf /tmp/grype.tar.gz -C /src/grype --strip-components=1
WORKDIR /src/syft
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go build -p 2 -trimpath -buildvcs=false -ldflags "-s -w -X main.version=1.52.0 -X main.gitCommit=02ba369d13b4248395b20a504eca94b0cab564d8 -X main.buildDate=2026-09-17T14:32:21Z" -o /out/syft ./cmd/syft \
    && go list -deps ./cmd/syft > /out/provenance/syft-packages.txt \
    && go version -m /out/syft > /out/provenance/syft-build.txt
WORKDIR /src/grype
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go build -p 2 -trimpath -buildvcs=false -ldflags "-s -w -X main.version=0.119.0 -X main.gitCommit=b6f5194537747ee7f705f4113069ac9eb269919f -X main.buildDate=2026-09-17T16:17:04Z" -o /out/grype ./cmd/grype \
    && go list -deps ./cmd/grype > /out/provenance/grype-packages.txt \
    && go version -m /out/grype > /out/provenance/grype-build.txt

FROM ghcr.io/astral-sh/uv:python3.14-alpine@sha256:ea7c8f721b5042fb12f6eb051b63469edfeb61c7c00551dbe67d71f182810c66 AS dependencies
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_LINK_MODE=copy
COPY security/zlib /opt/zlib-backport
RUN apk add --no-cache --virtual .zlib-build build-base patch \
    && sh /opt/zlib-backport/build.sh \
    && apk del .zlib-build
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project
ENV PATH="/app/.venv/bin:$PATH"

FROM dependencies AS analyzers
RUN apk add --no-cache squashfs-tools ca-certificates
COPY --from=analyzer-build /out/syft /out/grype /usr/local/bin/
COPY --from=analyzer-build /out/provenance /usr/local/share/firmwarelens/analyzers
COPY --from=analyzer-build /src/syft/LICENSE /usr/local/share/firmwarelens/analyzers/syft.LICENSE
COPY --from=analyzer-build /src/grype/LICENSE /usr/local/share/firmwarelens/analyzers/grype.LICENSE
RUN touch /etc/firmwarelens-sandbox && mkdir /work /input /intelligence

FROM analyzers AS sandbox
COPY src ./src
RUN uv pip install --no-deps -e .
USER 65532:65532
WORKDIR /work
ENTRYPOINT ["python", "-m", "firmwarelens.pipeline"]

FROM analyzers AS demo
RUN apk add --no-cache gcc musl-dev
COPY demo /demo
ENTRYPOINT ["python", "/demo/build.py"]

FROM dependencies AS checks
RUN uv sync --frozen --no-install-project
COPY src ./src
RUN uv pip install --no-deps -e .
COPY tests ./tests
COPY demo ./demo
COPY scripts ./scripts
COPY alembic ./alembic
COPY alembic.ini ./
ENTRYPOINT ["uv", "run"]
